{
  "name": "podcaster",
  "version": "0.1.0",
  "private": true,
  "description": "Mini-aplicación SPA para escuchar podcasts musicales (prueba técnica front-end Inditex)",
  "author": "yeradrod <jydiazrguez@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "npm run build && npm run serve",
    "serve": "serve --single --listen 3000 dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e",
    "serve:e2e": "npm run build && serve --single --listen 4000 dist",
    "test:e2e": "start-server-and-test serve:e2e http://localhost:4000 cy:run",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cypress": "^15.21.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-fixed-jsdom": "^0.0.11",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.13",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  }
}
